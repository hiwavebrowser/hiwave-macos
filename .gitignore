# Claude Code
.claude
.claude/
.claude/*

# Environment
.env
.env.*

# Rust build artifacts
target/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
nul

# Test artifacts
*.db
!schema.db

# Logs
*.log

# Local config
*.local.toml

# AI Orchestrator - local artifacts (ignored)
.ai
.ai/artifacts/
.ai/cache/
.ai/reports/
.ai/logs/
.ai/*

# Tools (ignore all except parity_oracle, real_window, element_diff and inspector)
tools/*
!tools/parity_oracle/
!tools/real_window/
!tools/element_diff/
!tools/inspector/
tools/element_diff/out/
tools/inspector/out/
tools/real_window/out/

# Keep work_orders, roadmap_index.json, and README.md tracked
# (they are NOT ignored because only the above subdirs are)

# Parity testing artifacts (large captures)
parity-history/
parity-baseline/captures/
parity-baseline/failure_packets/
# Per-run parity and WPT outputs (2026-09-23). Every run rewrites these, so
# committing them in PRs made every merge conflict with every other open PR.
# The numbers go in the PR body; master's history lives on the
# `metrics-history` branch (parity-metrics.yml).
parity-baseline/diffs/
parity-baseline/parity_test_results*.json
parity-baseline/oracle_results.json
trench/wpt/last-run.json
progress_report.json
/PARITY_PROGRESS.md
parity-baseline/workorders/
# Global, not per-directory. The old `scripts/__pycache__/` line was why
# scripts/tests/__pycache__/ kept getting committed — a narrow ignore looks
# like coverage and isn't. Five .pyc files reached master this way.
__pycache__/
*.pyc
*.pyo

fastrender/

# Pinned Chrome for Testing download (~150MB, machine-local; see trench/BASELINE-macos.md)
.browsers/

# WPT working copy — a projection of trench/wpt/MANIFEST.json, never the source of truth.
# Rebuild with scripts/wpt_sync.sh; do not vendor the WPT tree into this repo.
third_party/wpt/

# Python test caches (the .pyc files committed in #65 are no longer tracked).
scripts/tests/__pycache__/
# Seat-control baselines are a per-machine DIAGNOSTIC, never a receipt.
# They must not be committed and mistaken for the pinned macOS set.
# See tools/parity_oracle/capture_seat_control.mjs.
baselines/seat-control/

# Generated capture output (scripts/multisurface_canary.sh, scripts/builtins_capture.sh).
# The scripts recreate these; committed copies went stale and nothing read them.
multisurface-captures/
builtins-captures/*.layout.json
# scripts/websuite_capture.sh frames (6.8 MB each). Nothing reads them back.
websuite/captures/*.ppm

# Per-session agent scratch directories. Put anything worth keeping in
# trench/forensics or docs/ instead. (scratch_n41/ and scratch_n42/ are still
# tracked because trench/forensics cites them.)
/scratch_*/
