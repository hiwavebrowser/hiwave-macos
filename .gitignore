# Parity testing artifacts (large captures)
parity-history/
parity-baseline/captures/
parity-baseline/failure_packets/
progress_report.json
# Global, not per-directory. The old `scripts/__pycache__/` line was why
# scripts/tests/__pycache__/ kept getting committed — a narrow ignore looks
# like coverage and isn't. Five .pyc files reached master this way.
__pycache__/
*.pyc
*.pyo

fastrender/

# Pinned Chrome for Testing download (~150MB, machine-local; see trench/BASELINE-macos.md)
.browsers/