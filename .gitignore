# Claude Code
.claude
.claude/
.claude/*

# Environment
.env
.env.*

# Rust build artifacts
target/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
nul

# Test artifacts
*.db
!schema.db

# Logs
*.log

# Local config
*.local.toml

# AI Orchestrator - local artifacts (ignored)
.ai
.ai/artifacts/
.ai/cache/
.ai/reports/
.ai/logs/
.ai/*

# Tools (ignore all except parity_oracle)
tools/*
!tools/parity_oracle/

# Keep work_orders, roadmap_index.json, and README.md tracked
# (they are NOT ignored because only the above subdirs are)

# Parity testing artifacts (large captures)
parity-history/
parity-baseline/captures/
parity-baseline/failure_packets/
progress_report.json
# Global, not per-directory. The old `scripts/__pycache__/` line was why
# scripts/tests/__pycache__/ kept getting committed — a narrow ignore looks
# like coverage and isn't. Five .pyc files reached master this way.
__pycache__/
*.pyc
*.pyo

fastrender/

# Pinned Chrome for Testing download (~150MB, machine-local; see trench/BASELINE-macos.md)
.browsers/

# WPT working copy — a projection of trench/wpt/MANIFEST.json, never the source of truth.
# Rebuild with scripts/wpt_sync.sh; do not vendor the WPT tree into this repo.
third_party/wpt/

# Python test caches. NOTE: four .pyc files were committed by accident in #65 and are still TRACKED —
# this rule stops new ones, it does not untrack those. They need `git rm --cached`, which is not on the
# trench seat's allowlist.
scripts/tests/__pycache__/
# Seat-control captures: Chrome run on THIS seat, for the confound diagnostic only
# (trench/digest-parity-finish-line.md 2026-09-06). Never a receipt, and never a
# baseline — committing it would put a Linux/DejaVu/Chromium-141 capture beside the
# pinned macOS Chrome-148 set. #186 carries this same rule; duplicated here because
# that PR is unmerged and the directory surfaced as untracked on this branch on 09-07.
baselines/seat-control/
