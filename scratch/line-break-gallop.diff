+    #[test]
+    fn a_line_break_is_found_in_log_n_shapes_and_is_the_last_fit() {
+        // 400 words wrapped at 300px. Every line but the last must fit and
+        // must not have fit its next word: the break the linear scan found.
+        let shaper = TextShaper::new();
+        let chain = FontFamilyChain::new("Helvetica");
+        let words: Vec<String> = (0..400).map(|i| format!("w{}rd", "o".repeat(i % 7))).collect();
+        let text = words.join(" ");
+        let before = SHAPES.with(Cell::get);
+        let lines = shaper
+            .wrap_text(
+                &text,
+                &chain,
+                FontWeight(400),
+                FontStyle::Normal,
+                FontStretch::Normal,
+                16.0,
+                300.0,
+                CssWordBreak::Normal,
+                CssOverflowWrap::Normal,
+            )
+            .unwrap();
+        let shapes = SHAPES.with(Cell::get) - before;
+        assert!(lines.len() > 50, "{} lines", lines.len());
+        eprintln!("PROBE {shapes} shapes {} lines", lines.len());
+        // Linear: ~ (words per line + 3) shapes per line. Galloping: a
+        // handful. This bound fails on the linear scan (~15 per line).
+        assert!(
+            shapes <= lines.len() * 12,
+            "{shapes} shapes for {} lines",
+            lines.len()
+        );
+
+        let width = |s: &str| {
+            shaper
+                .shape(s, &chain, FontWeight(400), FontStyle::Normal, FontStretch::Normal, 16.0)
+                .unwrap()
+                .metrics
+                .width
+        };
+        for pair in lines.windows(2) {
+            let (line, next) = (&pair[0], &pair[1]);
+            let line_text = text[line.start_offset..line.end_offset].trim_end();
+            assert!(width(line_text) <= 300.0, "{line_text:?} overflows");
+            let next_word = text[next.start_offset..next.end_offset]
+                .split(' ')
+                .next()
+                .unwrap();
+            let with_next = format!("{line_text} {next_word}");
+            assert!(width(&with_next) > 300.0, "{with_next:?} would have fit");
+        }
     }
 
