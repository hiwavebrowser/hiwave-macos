     thread_local! {
         /// Uncached font resolutions on this thread.
         pub(super) static RESOLUTIONS: Cell<usize> = const { Cell::new(0) };
+        /// `TextShaper::shape` calls on this thread.
+        pub(super) static SHAPES: Cell<usize> = const { Cell::new(0) };
