{
  "case": "hero",
  "stage": "display_list",
  "kind": "expectations",
  "origin": "hand-derived from the CSS in page.html — paint order and background geometry",
  "viewport": { "width": 800, "height": 600 },
  "expect": [
    { "path": "commands[0].op",
      "value": "solid_color",
      "why": "the canvas is filled first" },
    { "path": "commands[0].rect.width",
      "value": 800.0,
      "why": "the canvas fill covers the viewport" },
    { "path": "commands[0].rect.height",
      "value": 600.0,
      "why": "the canvas fill covers the viewport" },

    { "path": "commands[1].op",
      "value": "solid_color",
      "why": "the hero's background paints over the canvas and under its text" },
    { "path": "commands[1].rect.x", "value": 0.0, "why": "body margin 0" },
    { "path": "commands[1].rect.y", "value": 0.0, "why": "body margin 0" },
    { "path": "commands[1].rect.width",
      "value": 432.0,
      "why": "a background paints over the BORDER box — the same 432 layout computed" },
    { "path": "commands[1].rect.height",
      "value": 152.0,
      "why": "a background paints over the BORDER box — the same 152 layout computed" },
    { "path": "commands[1].color.r", "value": 0,   "why": "#08c is rgb(0, 136, 204): 0x00" },
    { "path": "commands[1].color.g", "value": 136, "why": "#08c is rgb(0, 136, 204): 0x88" },
    { "path": "commands[1].color.b", "value": 204, "why": "#08c is rgb(0, 136, 204): 0xcc" },
    { "path": "commands[1].color.a", "value": 1.0, "why": "no alpha declared" },

    { "path": "commands[2].op",
      "value": "text",
      "why": "the h1's text paints last, over the hero it sits in" },
    { "path": "commands[2].text",
      "value": "Attribution",
      "why": "the h1's only text node" },
    { "path": "commands[2].font_size",
      "value": 32.0,
      "why": "h1 { font-size: 32px } — from the cascade, not the font" },
    { "path": "commands[2].font_weight",
      "value": 700,
      "why": "the UA stylesheet's h1 weight" },
    { "path": "commands[2].x",
      "value": 16.0,
      "why": "the hero's padding-left, with body margin 0 and h1 margin 0" }
  ]
}
